# Copy this file to .env and fill real values
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=company_research
POSTGRES_PORT=5433

BACKEND_PORT=8080
AI_SERVICE_PORT=8000

OPENAI_API_KEY="your_api_key"

# 공공데이터 API (선택, 없으면 해당 기능 비활성)
DART_API_KEY="your_dart_api_key"    
   
NAVER_CLIENT_ID="your_naver_client_id"
NAVER_CLIENT_SECRET="your_naver_client_secret"

# 이메일 인증 (Gmail 사용 시: 앱 비밀번호 발급 필요)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_app_password

# JWT (백엔드)
JWT_SECRET="change-this-to-a-random-secret-key-32-chars-min"

# 소셜 로그인 OAuth (선택, 없으면 해당 버튼 비활성)
VITE_GOOGLE_CLIENT_ID="your_google_client_id"
VITE_KAKAO_REST_API_KEY="your_kakao_rest_api_key"
VITE_NAVER_CLIENT_ID="your_naver_client_id"
KAKAO_REST_API_KEY="your_kakao_rest_api_key"
